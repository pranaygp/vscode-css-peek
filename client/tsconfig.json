{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "composite": true,
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
