{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "strict": true
  },
  "include": [],
  "exclude": ["node_modules", ".vscode-test"],
  "references": [
    {
      "path": "./client"
